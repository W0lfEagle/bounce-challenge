{
  "name": "bounce-challenge",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "overrides": {
    "react": "19.2.3",
    "test-renderer": "1.2.0"
  },
  "scripts": {
    "postinstall": "npm run build --workspace @bounce/contracts",
    "predev:web": "npm run build --workspace @bounce/contracts",
    "predev:api": "npm run build --workspace @bounce/contracts",
    "pretypecheck": "npm run build --workspace @bounce/contracts",
    "pretest": "npm run build --workspace @bounce/contracts",
    "dev:web": "npm run web --workspace @bounce/web",
    "dev:api": "npm run dev --workspace @bounce/api",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm test",
    "build": "npm run build --workspace @bounce/contracts && npm run build --workspace @bounce/api && npm run build --workspace @bounce/web",
    "db:migrate": "npm run db:migrate --workspace @bounce/api",
    "test:e2e": "npm run build --workspace @bounce/contracts && tsc --project e2e/tsconfig.json && playwright test",
    "demo": "npm run build --workspace @bounce/contracts && tsx e2e/demo.ts",
    "format": "prettier --write \"{apps/api/src,apps/web/src,packages/contracts/src}/**/*.{ts,tsx}\" \"apps/web/App*.tsx\" \"e2e/**/*.ts\" playwright.config.ts package.json e2e/tsconfig.json .prettierrc.json",
    "format:check": "prettier --check \"{apps/api/src,apps/web/src,packages/contracts/src}/**/*.{ts,tsx}\" \"apps/web/App*.tsx\" \"e2e/**/*.ts\" playwright.config.ts package.json e2e/tsconfig.json .prettierrc.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "prettier": "^3.9.9"
  }
}
